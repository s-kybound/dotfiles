;;; claude-code-guix --- Guix package for Anthropic's Claude Code CLI
;;;
;;; Upstream ships Claude Code as a self-contained Bun-compiled ELF binary in
;;; the platform specific npm package @anthropic-ai/claude-code-<os>-<arch>.
;;; The binary only links against glibc, so all it needs to run on Guix is a
;;; store-resolvable ELF interpreter and RUNPATH, which we set with patchelf.
;;; No FHS container, no install scripts, no network at build time.

(define-module (custompkgs claude-code)
  #:use-module (guix packages)
  #:use-module (guix download)
  #:use-module (guix gexp)
  #:use-module (guix utils)
  #:use-module (guix build-system copy)
  #:use-module ((guix licenses) #:prefix license:)
  #:use-module (gnu packages base)
  #:use-module (gnu packages bash)
  #:use-module (gnu packages bootstrap)
  #:use-module (gnu packages elf)
  #:use-module (srfi srfi-1))

(define %claude-code-version "2.1.266")

;; (npm platform suffix . sha256) per Guix system.
(define %claude-code-platforms
  `(("x86_64-linux"  "linux-x64"
     ,(base32 "1rfc196pic9s8rlnn9snyrbsbzka5bwqklq0hjm2ayw5na021wa9"))
    ("aarch64-linux" "linux-arm64"
     ,(base32 "02fsbnsykynv115l2mxjr6f4803sf55k94d62jzg057vi9qb3g6r"))))

(define (claude-code-platform system)
  (or (assoc-ref %claude-code-platforms system)
      (error "claude-code: unsupported system" system)))

(define claude-code-source
  (let* ((system (or (%current-target-system) (%current-system)))
         (platform (claude-code-platform system))
         (npm-suffix (first platform))
         (hash (second platform)))
    (origin
      (method url-fetch)
      (uri (string-append
            "https://registry.npmjs.org/@anthropic-ai/claude-code-" npm-suffix
            "/-/claude-code-" npm-suffix "-" %claude-code-version ".tgz"))
      (sha256 hash))))

(define-public claude-code
  (package
    (name "claude-code")
    (version %claude-code-version)
    (source claude-code-source)
    (build-system copy-build-system)
    (supported-systems (map car %claude-code-platforms))
    (arguments
     (list
      ;; The Bun runtime appends the JavaScript bundle to the ELF image;
      ;; stripping would discard it, and Guix's RUNPATH validator cannot
      ;; parse the resulting dynamic section.  Rewriting RUNPATH (which
      ;; relocates sections) likewise corrupts the trailer, so we only patch
      ;; the interpreter: Guix's ld.so already resolves libc.so.6 & friends
      ;; from its own glibc.
      #:strip-binaries? #f
      #:validate-runpath? #f
      #:install-plan
      #~'(("claude" "libexec/claude-code/claude")
          ("README.md" "share/doc/claude-code/"))
      #:phases
      #~(modify-phases %standard-phases
          ;; Would drop a pointless etc/ld.so.cache into the output.
          (delete 'make-dynamic-linker-cache)
          (add-after 'install 'patchelf
            (lambda _
              (let ((bin (string-append #$output "/libexec/claude-code/claude"))
                    (glibc #$(this-package-input "glibc")))
                (invoke "patchelf"
                        "--set-interpreter"
                        (string-append glibc #$(glibc-dynamic-linker))
                        bin))))
          (add-after 'patchelf 'install-wrapper
            (lambda _
              (let* ((bin (string-append #$output "/bin"))
                     (wrapper (string-append bin "/claude")))
                (mkdir-p bin)
                (call-with-output-file wrapper
                  (lambda (port)
                    (format port "#!~a/bin/sh
# Generated by claude-code-guix.  The store is immutable, so disable the
# self-updater; upgrades happen by bumping this package instead.
export DISABLE_AUTOUPDATER=1
exec \"~a/libexec/claude-code/claude\" \"$@\"
"
                            #$(this-package-input "bash-minimal")
                            #$output)))
                (chmod wrapper #o555)))))))
    (native-inputs (list patchelf))
    (inputs (list bash-minimal glibc))
    (home-page "https://github.com/anthropics/claude-code")
    (synopsis "Anthropic's agentic coding CLI")
    (description
     "Claude Code is a terminal tool that lets Claude read, edit and run
code in your project.  Repackages the official pre-built Linux binary to
run unmodified on Guix System.")
    (license
     (license:license "Anthropic Commercial Terms of Service"
                      "https://www.anthropic.com/legal/commercial-terms"
                      "Proprietary; binary redistribution only"))))

claude-code
